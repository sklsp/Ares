NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend defaults are intentionally local and require no secrets.
DATABASE_URL=sqlite:///./ecommerce_agent.db
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security: set API_KEY in production to require X-API-Key on every request.
# Leave empty for open local development.
API_KEY=

# SSRF guard: block private/loopback crawl destinations (recommended default).
# Enable only for local fixture testing.
CRAWLER_ALLOW_PRIVATE_ADDRESSES=false

# Jobs: false for production API replicas; run one or more `python -m app.worker` processes.
EMBEDDED_WORKER=true
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=20

# Optional OpenAI-compatible provider
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini